# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets.
#
# These values are read at build time by `crates/yryvu-bridge/build.rs` and
# baked into the binary as `option_env!()` constants. Builds without these
# variables compile fine; the OAuth flow short-circuits with
# `OAuthNotConfigured` and the rest of the app is unaffected.

# GitHub OAuth App (https://github.com/settings/developers)
# - Authorization callback URL: http://127.0.0.1/callback
# - Enable Device Flow: NO
CHAJA_GITHUB_OAUTH_CLIENT_ID=
CHAJA_GITHUB_OAUTH_CLIENT_SECRET=

# GitLab OAuth App (https://gitlab.com/-/profile/applications)
# Future — leave blank for now.
CHAJA_GITLAB_OAUTH_CLIENT_ID=
CHAJA_GITLAB_OAUTH_CLIENT_SECRET=

# Bitbucket OAuth Consumer (https://bitbucket.org/account/settings → OAuth consumers)
# Future — leave blank for now.
CHAJA_BITBUCKET_OAUTH_CLIENT_ID=
CHAJA_BITBUCKET_OAUTH_CLIENT_SECRET=
